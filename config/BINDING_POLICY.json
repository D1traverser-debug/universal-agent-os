{
  "schema_version": "1.8",
  "controller": "D1traverser-debug/universal-agent-os@main",
  "controller_ref": "D1traverser-debug/universal-agent-os@main:CURRENT_SYSTEM.json",
  "required_adapter_status": "UAOS_CONTROL_PLANE_ACTIVE",
  "required_manifest_status": "UAOS_CONTROL_PLANE_ACTIVE",
  "checks": [
    "ADAPTER_CONTROLLER",
    "ADAPTER_STATUS",
    "MANIFEST_CONTROLLER",
    "MANIFEST_STATUS",
    "MANIFEST_SKILL_ENTRYPOINT",
    "MANIFEST_ADAPTER_REF",
    "MANIFEST_CAPABILITY_REF",
    "CAPABILITY_DOMAIN_MATCH",
    "CAPABILITY_COMMON_INHERITANCE",
    "CAPABILITY_COMMON_CONTRACT_MINIMUM_WHEN_DECLARED",
    "CAPABILITY_REQUIRED_COMMON_SET",
    "SKILL_CONTROLLER_MARKER"
  ],
  "apply_on": ["NEW_TASK", "CONTINUE", "BEFORE_MATERIAL_DOMAIN_EXECUTION", "BEFORE_MATERIAL_MUTATION"],
  "authority_write_policy": "config/AUTHORITY_WRITE_POLICY.json",
  "mutation_rule": "DELEGATE_TO_AUTHORITY_WRITE_POLICY__BINDING_VALIDATION_MUST_NOT_REDEFINE_MUTATION_HIERARCHY",
  "common_capability_policy": "config/COMMON_CAPABILITIES.json",
  "common_behavior_assurance_policy": "config/COMMON_BEHAVIOR_ASSURANCE.json",
  "domain_health_escalation_policy": "config/DOMAIN_HEALTH_ESCALATION_POLICY.json",
  "domain_health_index": "state/DOMAIN_HEALTH_INDEX.json",
  "compatibility_rule": "DOMAIN_CAPABILITY_PROFILE_MUST_REFERENCE_CURRENT_UAOS_COMMON_CAPABILITIES_AND_DECLARE_UAOS_HOSTED_INHERITANCE; DOMAIN-SPECIFIC_REQUIRED_COMMON_CAPABILITIES MUST_EXIST_IN_CURRENT_COMMON_CAPABILITY_AUTHORITY; IF_THE_DOMAIN_DECLARES_uaos_common_capabilities_contract_min_THE_CURRENT_COMMON_CONTRACT_MUST_MEET_OR_EXCEED_IT",
  "current_problem_response_inheritance_rule": "A_REGISTERED_DOMAIN_CLAIMING_adaptive_deliberation_and_parent_guidance_MUST_INHERIT_THE_CURRENT_UAOS_PROBLEM_RESPONSE_SEMANTICS_RATHER_THAN_A_STALE_LOCAL_COPY",
  "problem_cognition_action_rule": "FOR_EVERY_DETECTED_PROBLEM__DELIBERATION_AND_ROOT_SCOPE_ADMISSION_MUST_PRECEDE_REPAIR_OR_NO_CHANGE__REPEATED_CROSS_SUBSYSTEM_ARCHITECTURE_GAP_COMPLEXITY_GROWTH_OR_SCOPE_EXPANSION_REQUIRES_CROSS_LAYER_HYPOTHESIS_COMPARISON_AND_ARCHITECTURE_UPSTREAM_TEST__EVOLUTION_DISPOSITION_PRECEDES_ACTION__MATERIAL_OR_EVOLUTION_RELEVANT_PROBLEMS_REQUIRE_DURABLE_CAUSAL_EVIDENCE",
  "operational_behavior_assurance_rule": "DECLARATION_OF_COMMON_CAPABILITY_INHERITANCE_IS_NOT_OPERATIONAL_PROOF; WHEN_UAOS_OR_A_DOMAIN_MAKES_AN_OPERATIONAL_CLAIM_FOR_AN_INHERITED_BEHAVIOR_THE_CLAIM_MUST_BE_BOUNDED_BY_OWNER_APPROPRIATE_EXECUTION_EVIDENCE_UNDER_config/COMMON_BEHAVIOR_ASSURANCE.json; ABSENT_SUCH_EVIDENCE_REPORT_DECLARED_ONLY_OR_UNVERIFIED_AND_BLOCK_ONLY_WHEN_THE_UNPROVEN_CAPABILITY_IS_A_HARD_PREREQUISITE",
  "proactive_domain_health_rule": "BEFORE_MATERIAL_DOMAIN_EXECUTION_OR_PARENT_GOVERNED_DESCENDANT_MUTATION_REREAD_CURRENT_CHILD_AUTHORITY_AND_EVALUATE_config/DOMAIN_HEALTH_ESCALATION_POLICY.json; PARENT_RELEASE_OR_PROFILE_OBSERVATIONS_ARE_CACHE_EVIDENCE_NOT_CHILD_AUTHORITY; REVISION_MISMATCH_IS_A_HEALTH_FINDING_AND_MUST_NOT_BE_SILENTLY_MASKED_BY_A_GREEN_PARENT_TEST",
  "multi_upcall_rule": "MULTIPLE_CHILD_PARENT_GUIDANCE_UPCALLS_MAY_COEXIST; REUSE_EXISTING_NONCONFLICTING_SCHEDULING_SEMANTICS; ONE_BLOCKED_CHILD_OR_ESCALATION_MUST_NOT_CREATE_A_GLOBAL_FIFO_BLOCKER_FOR_UNRELATED_DOMAINS_OR_UNAFFECTED_WORK",
  "cross_domain_failure_rule": "REPEATED_CREDIBLE_FAILURE_CLASSES_ACROSS_DOMAINS_SHOULD_BE_CLUSTERED_FOR_COMMON_DIAGNOSIS; SUSPECTED_COMMON_CAUSE_IS_NOT_AUTOMATIC_GLOBAL_BLOCKING_WITHOUT_EVIDENCE_OF_A_HARD_SHARED_DEPENDENCY_OR_UNSAFE_COMMON_INVARIANT",
  "recover_before_user_escalation_rule": "A_REGISTERED_DOMAIN_SHOULD_ATTEMPT_PROPORTIONATE_LAWFUL_RECOVERY_OF_A_PLAUSIBLY_RECOVERABLE_DEPENDENCY_FROM_CURRENT_AUTHORITY_STATE_ARTIFACTS_CONTEXT_OR_AVAILABLE_EVIDENCE_BEFORE_EXTERNALIZING_IT_TO_THE_USER; THIS_DOES_NOT_AUTHORIZE_FABRICATION_OR_BYPASS_REQUIRED_USER_APPROVAL",
  "problem_action_closure_rule": "ONLY_AFTER_ROOT_SCOPE_ADMISSION_AND_EVOLUTION_DISPOSITION__WHEN_AN_OWNER_AUTHORIZED_REPAIR_PATH_IS_CURRENTLY_AVAILABLE_WITHOUT_A_REQUIRED_USER_FACT_APPROVAL_AUTHORIZATION_OR_SAFETY_SENSITIVE_CHOICE_THE_ACTING_AGENT_MUST_ATTEMPT_THE_REPAIR_BEFORE_FINALIZING; RECOMMENDATION_ONLY_IS_NOT_OPERATIONAL_CLOSURE; A_REPAIR_ATTEMPTED_BEFORE_COGNITIVE_ADMISSION_IS_PROCESS_FAILURE_EVIDENCE_NOT_RETROACTIVE_PROOF",
  "evolution_evidence_interface_rule": "WHEN_A_CHILD_HAS_DURABLE_DOMAIN_EVOLUTION_HISTORY_OPEN_PARENT_GUIDANCE_OR_A_MATERIAL_EVOLUTION_PROMOTION_CLAIM_IT_SHOULD_EXPOSE_ONE_CANONICAL_OWNER_NATIVE_EVIDENCE_ENTRYPOINT_WITH_THE_MINIMUM_LOGICAL_ENVELOPE_DEFINED_BY_config/COMMON_BEHAVIOR_ASSURANCE.json; UAOS_MUST_NOT_REQUIRE_A_SHARED_CHILD_JOURNAL_STATE_MACHINE_OR_FILE_FORMAT",
  "causal_problem_history_rule": "EVERY_EVOLUTION_RELEVANT_OR_MATERIAL_DETECTED_PROBLEM_SHOULD_PRESERVE_OWNER_NATIVE_DURABLE_CAUSAL_EVIDENCE_FOR_SYMPTOM_COMPETING_HYPOTHESES_ROOT_SCOPE_MATERIAL_FAILED_OR_REJECTED_PATHS_SELECTED_REPAIR_VERIFICATION_RESULT_AND_OPEN_FOLLOWUP_AS_APPLICABLE; SMALL_LOCAL_DEFECTS_MAY_USE_COMPACT_RECORDS",
  "product_governance_inheritance_rule": "A_DOMAIN_REQUIRING_product_requirements_and_architecture_governance_MUST_KEEP_THE_COMMON_METHOD_PARENT_OWNED_AND_THE_RESULTING_DOMAIN_PRODUCT_REQUIREMENTS_AND_ARCHITECTURE_DOMAIN_OWNED",
  "business_authority_rule": "REGISTERED_DOMAIN_BUSINESS_LOGIC_STATE_IDENTITY_PRODUCT_REQUIREMENTS_ARCHITECTURE_AND_RULES_REMAIN_IN_THE_REGISTERED_DOMAIN_REPOSITORY; UAOS_MUST_NOT_RETAIN_A_COMPETING_CURRENT_BUSINESS_WORKFLOW_OR_BUSINESS_IDENTITY_AFTER_EXTERNAL_CUTOVER",
  "identity_boundary_rule": "UAOS_CONTROLLER_TASK_IDENTITY_AND_DOMAIN_BUSINESS_IDENTITY_ARE_DISTINCT_BY_DEFAULT; CORRELATION_USES_A_DOMAIN_DECLARED_OPAQUE_REFERENCE; NEVER_REQUIRE_ID_EQUALITY_UNLESS_THE_DOMAIN_EXPLICITLY_DECLARES_THAT_CONTRACT",
  "failure": "BLOCK_DOMAIN_EXECUTION_AS_BINDING_OR_AUTHORITY_DRIFT"
}
