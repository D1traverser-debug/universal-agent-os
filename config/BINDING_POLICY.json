{
  "schema_version": "1.1",
  "controller": "D1traverser-debug/universal-agent-os@main",
  "controller_ref": "D1traverser-debug/universal-agent-os@main:CURRENT_SYSTEM.json",
  "required_adapter_status": "UAOS_CONTROL_PLANE_ACTIVE",
  "required_manifest_status": "UAOS_CONTROL_PLANE_ACTIVE",
  "checks": [
    "ADAPTER_CONTROLLER",
    "ADAPTER_STATUS",
    "MANIFEST_CONTROLLER",
    "MANIFEST_STATUS",
    "MANIFEST_SKILL_ENTRYPOINT",
    "MANIFEST_ADAPTER_REF",
    "SKILL_CONTROLLER_MARKER"
  ],
  "apply_on": [
    "NEW_TASK",
    "CONTINUE",
    "BEFORE_MATERIAL_DOMAIN_EXECUTION",
    "BEFORE_MATERIAL_MUTATION"
  ],
  "authority_write_policy": "config/AUTHORITY_WRITE_POLICY.json",
  "mutation_rule": "SELECTED_AUTHORITY_CONTEXT_MUST_EQUAL_TARGET_AUTHORITY_OWNER__CROSS_SCOPE_REQUIRES_OWNER_HANDOFF_OR_PROPOSAL",
  "failure": "BLOCK_DOMAIN_EXECUTION_AS_BINDING_OR_AUTHORITY_DRIFT"
}
